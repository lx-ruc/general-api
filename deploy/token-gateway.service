[Unit]
Description=token gateway (LLM API relay)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/token-gateway
ExecStart=/opt/token-gateway/token-gateway -config /opt/token-gateway/config.yaml
Restart=always
RestartSec=3
# 高并发必备：每条 SSE 流占 2 个 fd（客户端 + 上游），1000 并发至少 8192，留足余量
LimitNOFILE=65535
# 安全加固
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/opt/token-gateway
# 敏感配置用环境变量注入（三选一按需启用）
#Environment=TG_JWT_SECRET=change-me
#Environment=TG_AES_KEY=
#Environment=TG_BOOTSTRAP_ADMIN_PASSWORD=change-me

[Install]
WantedBy=multi-user.target
